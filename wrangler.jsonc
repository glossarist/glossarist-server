{
  "name": "glossarist-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  "d1_databases": [{ "binding": "DB", "database_name": "glossarist", "database_id": "SET_BY_BOOTSTRAP" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "glossarist-artifacts" }],
  "kv_namespaces": [{ "binding": "VERSIONS", "id": "SET_BY_BOOTSTRAP" }]
}
