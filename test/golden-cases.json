{
  "description": "Golden e2e cases run against the live deployment after deploy (scripts/golden.mjs). Includes refusal behavior; French included per red-team pass 9.",
  "cases": [
    {
      "name": "registers-catalog",
      "path": "/v1/registers",
      "expect": {
        "status": 200,
        "registers-min": 11
      }
    },
    {
      "name": "registers-etag-304",
      "path": "/v1/registers",
      "expect": {
        "status": 200,
        "etag-304": true
      }
    },
    {
      "name": "search-french",
      "path": "/v1/search?q=mesurage&lang=fra",
      "expect": {
        "status": 200,
        "hits-min": 1
      }
    },
    {
      "name": "search-refusal-empty",
      "path": "/v1/search",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "search-no-hits-honest",
      "path": "/v1/search?q=zzzqqqxxx",
      "expect": {
        "status": 200,
        "hits": 0
      }
    },
    {
      "name": "unknown-concept-404",
      "path": "/v1/concepts/does-not-exist?register=vim-2012",
      "expect": {
        "status": 404,
        "problem": true
      }
    },
    {
      "name": "sparql-select",
      "path": "/sparql?query=SELECT%20%3Fc%20WHERE%20%7B%20%3Fc%20a%20skos%3AConcept%20%7D%20LIMIT%205",
      "expect": {
        "status": 200,
        "json-results": true,
        "bindings-min": 1
      }
    },
    {
      "name": "sparql-refusal-syntax",
      "path": "/sparql?query=SELCT%20garbage",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "sparql-write-refusal",
      "path": "/sparql?query=DELETE%20WHERE%20%7B%20%3Fs%20%3Fp%20%3Fo%20%7D",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "sparql-french-answer",
      "path": "/sparql?query=PREFIX%20skos%3A%20%3Chttp%3A%2F%2Fwww.w3.org%2F2004%2F02%2Fskos%2Fcore%23%3E%20SELECT%20%3Fl%20WHERE%20%7B%20%3Fc%20skos%3AprefLabel%20%3Fl%20FILTER%20(lang(%3Fl)%20%3D%20%22fra%22)%20%7D%20LIMIT%203",
      "expect": {
        "status": 200,
        "json-results": true,
        "bindings-min": 1
      }
    },
    {
      "name": "mcp-initialize",
      "path": "/mcp",
      "method": "POST",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {}
      },
      "expect": {
        "status": 200,
        "server-info": "glossarist-mcp"
      }
    },
    {
      "name": "mcp-tools-list",
      "path": "/mcp",
      "method": "POST",
      "body": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/list",
        "params": {}
      },
      "expect": {
        "status": 200,
        "tools-min": 6
      }
    },
    {
      "name": "dcat-jsonld",
      "path": "/dcat",
      "accept": "application/ld+json",
      "expect": {
        "status": 200,
        "content-type": "application/ld+json",
        "contains": [
          "dcat:Catalog",
          "JCGM"
        ]
      }
    },
    {
      "name": "dcat-turtle",
      "path": "/dcat",
      "accept": "text/turtle",
      "expect": {
        "status": 200,
        "content-type": "text/turtle",
        "contains": [
          "dcat:Catalog",
          "JCGM"
        ]
      }
    },
    {
      "name": "dcat-format-refusal",
      "path": "/dcat",
      "accept": "text/csv",
      "expect": {
        "status": 406,
        "problem": true
      }
    },
    {
      "name": "prov-jsonld",
      "path": "/prov",
      "accept": "application/ld+json",
      "expect": {
        "status": 200,
        "content-type": "application/ld+json",
        "contains": [
          "prov:Activity",
          "prov:Entity"
        ]
      }
    },
    {
      "name": "ontologies-index",
      "path": "/ontologies",
      "expect": {
        "status": 200,
        "contains": [
          "gloss"
        ]
      }
    },
    {
      "name": "ontologies-gloss-jsonld",
      "path": "/ontologies/gloss",
      "accept": "application/ld+json",
      "expect": {
        "status": 200,
        "content-type": "application/ld+json"
      }
    },
    {
      "name": "ontologies-gloss-turtle",
      "path": "/ontologies/gloss",
      "accept": "text/turtle",
      "expect": {
        "status": 200,
        "content-type": "text/turtle",
        "contains": [
          "@prefix",
          "gloss"
        ]
      }
    },
    {
      "name": "unknown-ontology-404",
      "path": "/ontologies/does-not-exist",
      "expect": {
        "status": 404,
        "problem": true
      }
    },
    {
      "name": "site-index",
      "path": "/",
      "expect": {
        "status": 200,
        "content-type": "text/html"
      }
    },
    {
      "name": "site-404",
      "path": "/vocab/no-such-page",
      "expect": {
        "status": 404,
        "content-type": "text/html"
      }
    },
    {
      "name": "site-data-ttl",
      "path": "/vocab/data/versions.ttl",
      "expect": {
        "status": 200,
        "content-type": "text/turtle"
      }
    },
    {
      "name": "api-404-stays-json",
      "path": "/v1/no-such-route",
      "expect": {
        "status": 404,
        "problem": true
      }
    },
    {
      "name": "ontologies-gloss-shacl-turtle",
      "path": "/ontologies/gloss-shacl",
      "accept": "text/turtle",
      "expect": {
        "status": 200,
        "content-type": "text/turtle",
        "contains": [
          "sh:NodeShape"
        ]
      }
    },
    {
      "name": "ontologies-gloss-shacl-jsonld",
      "path": "/ontologies/gloss-shacl",
      "accept": "application/ld+json",
      "expect": {
        "status": 200,
        "content-type": "application/ld+json"
      }
    },
    {
      "name": "conformance-json",
      "path": "/conformance",
      "expect": {
        "status": 200,
        "contains": [
          "sparql-subset",
          "not-implemented"
        ]
      }
    }
  ]
}